+\frac{1}{2{g}_{Y}}{\left(\sqrt{I\left({I+1}\right)-\left\langle {\widehat{J}}^{2}_{z}\right\rangle }-\left\langle {\widehat{J}}_{x}\right\rangle \right)}^{2},\tag{11.134}
\]

