这并不难执行，
其结果为：
\begin_inset Formula 
\begin{equation}
(V_{\text{eff}}^{3p-1h})_{mn,m^{\prime}n^{\prime}}=\left\{ \sum_{pi}\frac{\bar{v}_{mi,m^{\prime}p}\bar{v}_{pn,in^{\prime}}}{\Omega_{\tau}-\epsilon_{m^{\prime}}-\epsilon_{n}-\epsilon_{p}+\epsilon_{i}}-(n^{\prime}\leftrightarrow m^{\prime})\right\} -(m\leftrightarrow n)\label{eq:4.90}
\end{equation}
\end_inset

