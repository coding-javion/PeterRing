\begin_layout Enumerate
一个特殊的Bogoliubov变换，

\begin_inset Formula 
\begin{align}
\alpha_{p}^{\dagger} & =u_{p}a_{p}^{\dagger}-v_{p}a_{\bar{p}}\nonumber \\
\alpha_{\bar{p}}^{\dagger} & =u_{p}a_{\bar{p}}^{\dagger}+v_{p}a_{p}\label{eq:special Bogoliuboc transformation 1}
\end{align}

\end_inset

\end_layout

\begin_deeper
\begin_layout Standard
这里
\begin_inset Formula $(p,\bar{p})$
\end_inset
