\[
R^{\prime}=\sqrt{(x+x_{0})^{2}+(y+y_{0})^{2}+(z+z_{0})^{2}}\approx R+\frac{xx_{0}+yy_{0}+zz_{0}}{x^{2}+y^{2}+z^{2}}
\]

\end_inset

\end_layout

