\begin_layout Section
多体问题的壳模型方法
\begin_inset CommandInset label
LatexCommand label
name "sec:多体问题的壳模型方法"
\end_inset
\end_layout

\begin_layout Standard
严格的原子核微观理论建立在非相对论量子多体问题之上，其总微观 Hamilton 量包含核子动能与两体相互作用：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
H = \sum_{i=1}^A t_i + \frac{1}{2}\sum_{i \neq j}^A v(i,j)\label{eq:full_microscopic_H}
\end{equation}
\end_inset
\end_layout

\begin_layout Standard
其中 
\begin_inset Formula $i = (\boldsymbol{r}_i, \boldsymbol{s}_i, \boldsymbol{t}_i)$
\end_inset
 表示单个核子的全部空间、自旋与同位旋坐标。壳模型方法的核心思想是在总 Hamilton 量中引入一个平均单粒子势场 
\begin_inset Formula $U(i)$
\end_inset
，并将全 Hamilton 量精确分解为无相互作用的独立粒子单体 Hamilton 量 
\begin_inset Formula $H_0$
\end_inset
 与剩余相互作用（Residual interaction）
\begin_inset Formula $V_{\text{res}}$
\end_inset
：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
H = H_0 + V_{\text{res}}\label{eq:H_split_H0_Vres}
\end{equation}
\end_inset
\end_layout

\begin_layout Standard
其中：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align}
H_0 &= \sum_{i=1}^A h(i) = \sum_{i=1}^A \left[t_i + U(i)\right]\nonumber\\
V_{\text{res}} &= \frac{1}{2}\sum_{i \neq j}^A v(i,j) - \sum_{i=1}^A U(i)\label{eq:V_residual_def}
\end{align}
\end_inset
\end_layout

\begin_layout Standard
求解单粒子薛定谔方程：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
h(i) \phi_k(i) = \varepsilon_k \phi_k(i)\label{eq:single_particle_schrodinger}
\end_inset
\end_layout

\begin_layout Standard
本征态 
\begin_inset Formula $\phi_k$
\end_inset
 构成二次量子化表象（附录 C）的正交归一基底。设 
\begin_inset Formula $a_k^\dagger$
\end_inset
 与 
\begin_inset Formula $a_k$
\end_inset
 分别为轨道 
\begin_inset Formula $k$
\end_inset
 上的费米子产生与湮灭算符，则独立粒子 Hamilton 量可写为：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
H_0 = \sum_k \varepsilon_k a_k^\dagger a_k\label{eq:H0_second_quantized}
\end_inset
\end_layout

\begin_layout Standard
对于双满壳闭壳核，核子从最低轨道一直填到 Fermi 能级 
\begin_inset Formula $\varepsilon_F$
\end_inset
，体系基态由单一 Slater 行列式给出：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
|\Phi_0\rangle = \prod_{i \leqslant \varepsilon_F} a_i^\dagger |-\rangle\label{eq:slater_ground_state}
\end_inset
\end_layout

