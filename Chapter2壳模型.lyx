\begin_layout Subsection
Strutinsky 壳修正能的计算
\end_layout

\begin_layout Standard
利用确定的平滑函数 
\begin_inset Formula $f(x)$
\end_inset
，由离散谱 
\begin_inset Formula $g(\varepsilon) = \sum_i \delta(\varepsilon - \varepsilon_i)$
\end_inset
 得到的平滑能级密度为：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\tilde{g}(\varepsilon) = \sum_i \frac{1}{\gamma} f\left(\frac{\varepsilon - \varepsilon_i}{\gamma}\right)\label{eq:strut_g_smooth_sum}
\end{equation}
\end_inset
\end_layout

\begin_layout Standard
将其代入粒子数积分，可引入广义占据数 
\begin_inset Formula $\tilde{n}_i$
\end_inset
：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
A = \sum_i \tilde{n}_i = \sum_i \int_{-\infty}^{t_i} f(x)\,\mathrm{d}x,\quad t_i = \frac{\tilde{\lambda} - \varepsilon_i}{\gamma}\label{eq:strut_n_tilde}
\end{equation}
\end_inset
\end_layout

\begin_layout Standard
由此平滑能量可写为：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\tilde{E}_{\text{sh}} = \sum_i \varepsilon_i \tilde{n}_i + F\label{eq:strut_E_smooth_F}
\end{equation}
\end_inset
\end_layout

\begin_layout Standard
其中残余项 
\begin_inset Formula $F$
\end_inset
 为：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
F = \sum_i \int_{-\infty}^{\tilde{\lambda}} (\varepsilon - \varepsilon_i)\frac{1}{\gamma} f\left(\frac{\varepsilon - \varepsilon_i}{\gamma}\right)\,\mathrm{d}\varepsilon = \gamma \sum_i \int_{-\infty}^{t_i} x f(x)\,\mathrm{d}x\label{eq:strut_F_def}
\end{equation}
\end_inset
\end_layout

\begin_layout Standard
对平滑能量对 
\begin_inset Formula $\gamma$
\end_inset
 求导可得：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\frac{\partial \tilde{E}_{\text{sh}}}{\partial \gamma} = \frac{1}{\gamma} F + \tilde{\lambda} \frac{\partial}{\partial \gamma}\sum_i \tilde{n}_i = \frac{1}{\gamma} F + \tilde{\lambda} \frac{\partial A}{\partial \gamma} = \frac{1}{\gamma} F\label{eq:strut_dE_dgamma}
\end{equation}
\end_inset
\end_layout

\begin_layout Standard
由于核子数 
\begin_inset Formula $A$
\end_inset
 严格守恒（
\begin_inset Formula $\partial A/\partial \gamma = 0$
\end_inset
），坪区条件 
\begin_inset Formula $\partial \tilde{E}_{\text{sh}}/\partial \gamma = 0$
\end_inset
 恰好等价于 
\begin_inset Formula $F = 0$
\end_inset
！定义纯壳模型的阶梯占据数：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
n_i = \begin{cases} 1, & \varepsilon_i \leqslant \varepsilon_F \\ 0, & \varepsilon_i > \varepsilon_F \end{cases}\label{eq:strut_step_n}
\end_inset
\end_layout

\begin_layout Standard
则总壳修正能 
\begin_inset Formula $E_{\text{osc}}$
\end_inset
 可以极为优美简洁地表示为占据数偏差 
\begin_inset Formula $\delta n_i = n_i - \tilde{n}_i$
\end_inset
 的单粒子能级加权和：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{\text{osc}} = \sum_i \varepsilon_i (n_i - \tilde{n}_i) = \sum_i \varepsilon_i \delta n_i\label{eq:strut_E_osc_final}
\end{equation}
\end_inset
\end_layout

