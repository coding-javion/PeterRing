\begin_layout Subsection
强度函数的能量加权矩
\begin_inset CommandInset label
LatexCommand label
name "subsec:8.7.1_强度函数的能量加权矩"

\end_inset

\end_layout

\begin_layout Standard
对于厄米单体算符 
\begin_inset Formula $F=\sum_{p}f(\boldsymbol{r}_{p})$
\end_inset
，求和规则定义为强度分布的 
\begin_inset Formula $k$
\end_inset
 阶矩：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
S_{k}(F)=\sum_{\nu>0}(E_{\nu}-E_{0})^{k}|\langle\nu|F|0\rangle|^{2}\label{eq:sumrule_moment_def}
\end{equation}
\end_inset

\end_layout

\begin_layout Standard
利用完备性关系，可写为：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
S_{k}=\langle 0|F(H-E_{0})^{k}F|0\rangle\label{eq:sumrule_operator_moment}
\end{equation}
\end_inset

\end_layout

\begin_layout Standard
根据 Lane 等人［MBF 76, BML 76, BLM 79］的研究，可以定义表征强度分布的特征能量：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\bar{E}_{k}=\sqrt{\frac{S_{k}}{S_{k-2}}}\label{eq:sumrule_average_energy_def}
\end{equation}
\end_inset

\end_layout

\begin_layout Standard
由 Schwarz 不等式 
\begin_inset Formula $S_{k+2}S_{k}\ge S_{k+1}^{2}$
\end_inset
，可以导出 
\begin_inset Formula $\bar{E}_{3}\ge\bar{E}_{1}$
\end_inset
，并且围绕平均能量的均方涨落满足：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\sigma^{2}=\bar{E}^{2}-\bar{E}_{1}^{2}\le\frac{1}{4}\left(\bar{E}_{3}^{2}-\bar{E}_{1}^{2}\right)\label{eq:sumrule_energy_dispersion_bound}
\end{equation}
\end_inset

\end_layout

\begin_layout Subsection
\begin_inset Formula $S_{1}$
\end_inset
 求和规则与 RPA 方法
\begin_inset CommandInset label
LatexCommand label
name "subsec:8.7.2_S1求和规则与RPA方法"

\end_inset

\end_layout

\begin_layout Standard
最重要的求和规则是能量加权求和规则（EWSR）
\begin_inset Formula $S_{1}$
\end_inset
。它可以精确表达为双对易子的基态期望值：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
S_{1}(F)=\frac{1}{2}\langle 0|[F,[H,F]]|0\rangle\label{eq:sumrule_double_commutator_exact}
\end{equation}
\end_inset

\end_layout

\begin_layout Standard
Thouless［Th 61a］证明了一条极为优美的定理：若左端项采用 RPA 激发能量与跃迁振幅计算，而右端项在自洽 Hartree-Fock 基态下求值，则等式 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:sumrule_double_commutator_exact"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset
) 严格成立：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\sum_{\nu>0}\hbar\Omega_{\nu}|\langle\nu|F|0\rangle_{\text{RPA}}|^{2}=\frac{1}{2}\langle\text{HF}|[F,[H,F]]|\text{HF}\rangle\label{eq:sumrule_thouless_theorem_rpa}
\end{equation}
\end_inset

\end_layout

\begin_layout Subsection
求和规则 
\begin_inset Formula $S_{1},S_{-1},S_{3}$
\end_inset
 的求值
\begin_inset CommandInset label
LatexCommand label
name "subsec:8.7.3_求和规则的求值"

\end_inset

\end_layout

\begin_layout Standard
对于坐标空间中的局域单体算符 
\begin_inset Formula $F(\boldsymbol{r})$
\end_inset
，它与速度无关的两体势严格对易，动能项对双对易子的贡献为：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
[F,[H,F]]=\frac{\hbar^{2}}{m}\sum_{i=1}^{A}|\boldsymbol{\nabla}F(\boldsymbol{r}_{i})|^{2}\label{eq:sumrule_kinetic_double_commutator}
\end{equation}
\end_inset

\end_layout

\begin_layout Standard
因此 
\begin_inset Formula $S_{1}$
\end_inset
 求和规则由基态核密度直接给出：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
S_{1}(F)=\frac{\hbar^{2}}{2m}\int|\boldsymbol{\nabla}F(\boldsymbol{r})|^{2}\rho_{0}(\boldsymbol{r})\,\mathrm{d}^{3}r\label{eq:sumrule_s1_density_integral}
\end{equation}
\end_inset

\end_layout

\begin_layout Standard
对于多极算符 
\begin_inset Formula $F_{LM}=r^{L}Y_{LM}$
\end_inset
（
\begin_inset Formula $L\ge 1$
\end_inset
），式 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:sumrule_s1_density_integral"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset
) 给出：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
S_{1}(r^{L}Y_{L0})=\frac{\hbar^{2}}{8\pi m}L(2L+1)A\langle r^{2L-2}\rangle\label{eq:sumrule_multipole_ewsr}
\end{equation}
\end_inset

\end_layout

\begin_layout Standard
对于单极算符 
\begin_inset Formula $F_{0}=\sum_{i}r_{i}^{2}$
\end_inset
，我们得到：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
S_{1}(r^{2})=\frac{2\hbar^{2}}{m}A\langle r^{2}\rangle\label{eq:sumrule_monopole_ewsr}
\end{equation}
\end_inset

\end_layout

\begin_layout Standard
反能量加权求和规则 
\begin_inset Formula $S_{-1}$
\end_inset
 与静态极化率直接相连：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
S_{-1}(F)=\frac{1}{2}\alpha\label{eq:sumrule_sminus1_polarizability}
\end{equation}
\end_inset

\end_layout

\begin_layout Standard
而三次能量加权矩 
\begin_inset Formula $S_{3}$
\end_inset
 则与流体动力学动能模量及核物质不可压缩性紧密关联［BLM 79］。
\end_layout

\begin_layout Subsection
求和规则与极化率
\begin_inset CommandInset label
LatexCommand label
name "subsec:8.7.4_求和规则与极化率"

\end_inset

\end_layout

\begin_layout Standard
利用介于 
\begin_inset Formula $S_{1}$
\end_inset
 与 
\begin_inset Formula $S_{-1}$
\end_inset
 之间的比值，可以定义约束能量（constrained energy）：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{\text{constr}}=\sqrt{\frac{S_{1}}{S_{-1}}}=\sqrt{\frac{2S_{1}}{\alpha}}\label{eq:sumrule_constrained_energy}
\end{equation}
\end_inset

\end_layout

\begin_layout Standard
在宏观液滴模型或流体动力学模型中，它恰好对应于唯象谐振子的频率 
\begin_inset Formula $\hbar\omega=\sqrt{C/B}$
\end_inset
，其中恢复力常数 
\begin_inset Formula $C=1/\alpha$
\end_inset
，质量参数 
\begin_inset Formula $B=\hbar^{2}/(2S_{1})$
\end_inset
。
\end_layout

\begin_layout Subsection
跃迁流与跃迁密度的计算
\begin_inset CommandInset label
LatexCommand label
name "subsec:8.7.5_跃迁流与跃迁密度的计算"

\end_inset

\end_layout

\begin_layout Standard
在单个集体态耗尽了绝大部分求和规则的情形下，局部求和规则可以直接导出该集体模式的跃迁密度与跃迁流。对于 
\begin_inset Formula $L>0$
\end_inset
 的表面多极振动，得到 Bohr-Tassie 模型［Bo 52, Ta 56a］的无旋不可压缩流体跃迁密度：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\rho^{(\nu)}(\boldsymbol{r})\propto r^{L-1}\frac{\mathrm{d}\rho_{0}(r)}{\mathrm{d}r}Y_{LM}(\hat{\boldsymbol{r}})\label{eq:sumrule_tassie_transition_density}
\end{equation}
\end_inset

\end_layout

\begin_layout Standard
而对于 
\begin_inset Formula $L=0$
\end_inset
 的呼吸模，得到 Werntz-Überall 模型［WU 66］的可压缩流体跃迁密度：
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\rho^{(\nu)}(\boldsymbol{r})\propto\left(3\rho_{0}(r)+r\frac{\mathrm{d}\rho_{0}(r)}{\mathrm{d}r}\right)\label{eq:sumrule_breathing_transition_density}
\end_inset

\end_layout

